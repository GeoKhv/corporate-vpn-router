+#[cfg(test)]
+mod router_pin_tests {
+    use super::*;
+    use openssl::{
+        asn1::Asn1Time,
+        bn::BigNum,
+        rsa::Rsa,
+        x509::{
+            X509Builder, X509NameBuilder,
+            extension::{BasicConstraints, KeyUsage},
+        },
+    };
+    fn cert(name: &str, issuer: Option<(&X509, &PKey<Private>)>, ca: bool, expired: bool) -> (X509, PKey<Private>) {
+        let key = PKey::from_rsa(Rsa::generate(2048).unwrap()).unwrap();
+        let mut n = X509NameBuilder::new().unwrap();
+        n.append_entry_by_text("CN", name).unwrap();
+        let n = n.build();
+        let mut c = X509Builder::new().unwrap();
+        c.set_version(2).unwrap();
+        c.set_serial_number(
+            &BigNum::from_u32(if ca { 1 } else { 2 })
+                .unwrap()
+                .to_asn1_integer()
+                .unwrap(),
+        )
+        .unwrap();
+        c.set_subject_name(&n).unwrap();
+        c.set_issuer_name(issuer.map(|(c, _)| c.subject_name()).unwrap_or(&n))
+            .unwrap();
+        c.set_pubkey(&key).unwrap();
+        c.set_not_before(&Asn1Time::from_unix(1).unwrap()).unwrap();
+        let expiry = if expired {
+            Asn1Time::from_unix(2).unwrap()
+        } else {
+            Asn1Time::days_from_now(1).unwrap()
+        };
+        c.set_not_after(&expiry).unwrap();
+        if ca {
+            c.append_extension(BasicConstraints::new().critical().ca().build().unwrap())
+                .unwrap();
+            c.append_extension(KeyUsage::new().key_cert_sign().crl_sign().build().unwrap())
+                .unwrap();
+        }
+        c.sign(issuer.map(|(_, k)| k).unwrap_or(&key), MessageDigest::sha256())
+            .unwrap();
+        (c.build(), key)
+    }
+    fn fp(c: &X509) -> String {
+        let d = c.digest(MessageDigest::sha1()).unwrap();
+        crate::rfc1751::key_to_english(d[..16].try_into().unwrap()).join(" ")
+    }
+    #[test]
+    fn router_signing_certificate_is_bound_to_trusted_identity() {
+        let (ca, ca_key) = cert("Test CA", None, true, false);
+        let (leaf, _) = cert("Test gateway", Some((&ca, &ca_key)), false, false);
+        let (bad, _) = cert("Untrusted gateway", None, false, false);
+        let (expired, _) = cert("Expired gateway", Some((&ca, &ca_key)), false, true);
+        assert!(
+            CertList(vec![leaf.clone(), ca.clone()])
+                .verify_gateway_fingerprints(&[fp(&ca)])
+                .is_ok()
+        );
+        assert!(
+            CertList(vec![leaf.clone()])
+                .verify_gateway_fingerprints(&[fp(&leaf)])
+                .is_ok()
+        );
+        assert!(
+            CertList(vec![bad, ca.clone()])
+                .verify_gateway_fingerprints(&[fp(&ca)])
+                .is_err()
+        );
+        assert!(
+            CertList(vec![leaf.clone(), ca.clone()])
+                .verify_gateway_fingerprints(&[])
+                .is_err()
+        );
+        assert!(
+            CertList(vec![leaf, ca])
+                .verify_gateway_fingerprints(&["wrong identity".into()])
+                .is_err()
+        );
+        assert!(
+            CertList(vec![expired.clone()])
+                .verify_gateway_fingerprints(&[fp(&expired)])
+                .is_err()
+        );
+    }
