+    /// Bind the signing (first) certificate to an identity from pinned CCC.
+    /// An unrelated appended certificate must never authenticate the first one.
+    pub fn verify_gateway_fingerprints(&self, trusted: &[String]) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            !trusted.is_empty() && !self.0.is_empty(),
+            "Missing authenticated IKE identity"
+        );
+        let now = openssl::asn1::Asn1Time::days_from_now(0)?;
+        let leaf = &self.0[0];
+        anyhow::ensure!(
+            leaf.not_before() <= now && leaf.not_after() >= now,
+            "IKE certificate expired or not yet valid"
+        );
+        let mut anchors = Vec::new();
+        for (index, cert) in self.0.iter().enumerate() {
+            let digest = cert.digest(MessageDigest::sha1())?;
+            let fingerprint = crate::rfc1751::key_to_english(digest[..16].try_into()?).join(" ");
+            if trusted.contains(&fingerprint) {
+                if index == 0 {
+                    return Ok(());
+                }
+                anchors.push(Bytes::from(cert.to_der()?));
+            }
+        }
+        anyhow::ensure!(!anchors.is_empty(), "Untrusted IKE gateway certificate");
+        self.verify(&anchors)
+    }
