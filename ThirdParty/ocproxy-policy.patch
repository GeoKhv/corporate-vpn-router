+/* Corporate VPN Router: require an exact domain or label-boundary suffix.
+ * This check runs on the only listener, before any DNS lookup or TCP SYN. */
+static int cvr_rule_port(const char *ports, const char *domain, unsigned int port)
+{
+    char key[272];
+    snprintf(key, sizeof(key), "|%s:%u|", domain, port);
+    if (strstr(ports, key)) return 1;
+    snprintf(key, sizeof(key), "|%s:*|", domain);
+    return strstr(ports, key) != NULL;
+}
+
+static int cvr_allowed(const unsigned char *name, size_t n, unsigned int port)
+{
+    char hostname[256], key[260], portkey[12];
+    const char *domains = getenv("CVR_DOMAINS"), *ports = getenv("CVR_PORTS");
+    size_t i; char *label;
+    int scoped = ports && strstr(ports, "|@scoped|");
+    if (!name || !n) return 0;
+    if (n && name[n-1] == '.') --n;
+    if (!domains || !ports || n == 0 || n > 253) return 0;
+    snprintf(portkey, sizeof(portkey), "|%u|", port);
+    for (i = 0; i < n; ++i) {
+        unsigned char c = name[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+                c == '-' || c == '.')) return 0;
+        if ((c == '.' && (!i || name[i-1] == '.' || i+1 == n))) return 0;
+        hostname[i] = c;
+    }
+    hostname[n] = 0;
+    if (port && !scoped && !strstr(ports, portkey)) {
+        char endpoint[264];
+        snprintf(endpoint, sizeof(endpoint), "|%s:%u|", hostname, port);
+        if (!strstr(ports, endpoint)) return 0;
+    }
+    snprintf(key, sizeof(key), "|!%s|", hostname);
+    if (strstr(domains, key)) return 0;
+    snprintf(key, sizeof(key), "|=%s|", hostname);
+    if (strstr(domains, key)) {
+        char endpoint[272];
+        snprintf(endpoint, sizeof(endpoint), "|=%s:%u|", hostname, port);
+        return !port || !scoped || cvr_rule_port(ports, hostname, port) || strstr(ports, endpoint);
+    }
+    for (label = hostname; label; ) {
+        snprintf(key, sizeof(key), "|%s|", label);
+        if (strstr(domains, key)) {
+            char endpoint[272];
+            snprintf(endpoint, sizeof(endpoint), "|=%s:%u|", hostname, port);
+            return !port || !scoped || cvr_rule_port(ports, label, port) || strstr(ports, endpoint);
+        }
+        label = strchr(label, '.'); if (label) ++label;
+    }
+    return 0;
+}
