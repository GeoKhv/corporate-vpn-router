+/* Corporate VPN Router: require an exact domain or label-boundary suffix.
+ * This check runs on the only listener, before any DNS lookup or TCP SYN. */
+static int cvr_allowed(const unsigned char *name, size_t n, unsigned int port)
+{
+    char hostname[256], key[260], portkey[12];
+    const char *domains = getenv("CVR_DOMAINS"), *ports = getenv("CVR_PORTS");
+    size_t i; char *label;
+    if (!domains || !ports || n == 0 || n > 253) return 0;
+    snprintf(portkey, sizeof(portkey), "|%u|", port);
+    if (!strstr(ports, portkey)) return 0;
+    for (i = 0; i < n; ++i) {
+        unsigned char c = name[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+                c == '-' || c == '.')) return 0;
+        if ((c == '.' && (!i || name[i-1] == '.' || i+1 == n))) return 0;
+        hostname[i] = c;
+    }
+    hostname[n] = 0;
+    for (label = hostname; label; ) {
+        snprintf(key, sizeof(key), "|%s|", label);
+        if (strstr(domains, key)) return 1;
+        label = strchr(label, '.'); if (label) ++label;
+    }
+    return 0;
+}
