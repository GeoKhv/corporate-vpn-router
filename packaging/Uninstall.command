#!/bin/zsh
# Finder compatibility for users who kept the old helper. Do not remove files before policy restoration.
open "$HOME/Applications/Corporate VPN Router.app"
printf '%s\n' 'В меню значка VPN выберите «Удалить Router…». Приложение проверит профиль Chrome, вернёт управление и снимет собственный автозапуск.'
